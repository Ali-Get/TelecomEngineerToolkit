<UserControl x:Class="Toolkit.UI.Views.CoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Application.ViewModels;assembly=Toolkit.Application">
    <UserControl.DataContext>
        <vm:CoverageViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Inputs and Site List -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Add Site" FontWeight="Bold"/>
            <WrapPanel><TextBlock Text="Site Name:" Width="80"/><TextBox Text="{Binding SiteName}" Width="120"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Latitude:" Width="80"/><TextBox Text="{Binding Latitude}" Width="120"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Longitude:" Width="80"/><TextBox Text="{Binding Longitude}" Width="120"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Tower Height:" Width="80"/><TextBox Text="{Binding TowerHeight}" Width="120"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Sector Name:" Width="80"/><TextBox Text="{Binding SectorName}" Width="120"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Azimuth:" Width="80"/><TextBox Text="{Binding Azimuth}" Width="120"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Beamwidth:" Width="80"/><TextBox Text="{Binding Beamwidth}" Width="120"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Radius (km):" Width="80"/><TextBox Text="{Binding RadiusKm}" Width="120"/></WrapPanel>
            <Button Content="Add Site" Command="{Binding AddSiteCommand}" Width="100" Margin="0,10"/>

            <TextBlock Text="Sites" FontWeight="Bold" Margin="0,10,0,5"/>
            <ListView ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}" Height="150">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="100"/>
                        <GridViewColumn Header="Lat" DisplayMemberBinding="{Binding Latitude}" Width="60"/>
                        <GridViewColumn Header="Lon" DisplayMemberBinding="{Binding Longitude}" Width="60"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Content="Add Sector" Command="{Binding AddSectorCommand}" Width="80" Margin="2"/>
                <Button Content="Delete Site" Command="{Binding DeleteSiteCommand}" Width="80" Margin="2"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Width="80" Margin="2"/>
            </StackPanel>
        </StackPanel>

        <!-- Right Panel: Canvas Map -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="10,0,0,0">
            <Canvas x:Name="MapCanvas" Background="White"/>
        </Border>
    </Grid>
</UserControl>