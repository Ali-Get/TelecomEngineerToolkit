<UserControl x:Class="Toolkit.UI.Views.SitePowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Application.ViewModels;assembly=Toolkit.Application">
    <UserControl.DataContext>
        <vm:SitePowerViewModel/>
    </UserControl.DataContext>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Add Device" FontWeight="Bold"/>
            <WrapPanel><TextBlock Text="Name:" Width="60"/><TextBox Text="{Binding NewDeviceName}" Width="100"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Qty:" Width="60"/><TextBox Text="{Binding NewQuantity}" Width="100"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Power (W):" Width="60"/><TextBox Text="{Binding NewPower}" Width="100"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Hours:" Width="60"/><TextBox Text="{Binding NewHours}" Width="100"/></WrapPanel>
            <Button Content="Add" Command="{Binding AddDeviceCommand}" Width="60" Margin="0,5"/>
            <Button Content="Calculate" Command="{Binding CalculateCommand}" Width="80"/>
            <Button Content="Clear All" Command="{Binding ClearCommand}" Width="80" Margin="5,0"/>
        </StackPanel>
        <ListView ItemsSource="{Binding Devices}" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="100"/>
                    <GridViewColumn Header="Qty" DisplayMemberBinding="{Binding Quantity}" Width="50"/>
                    <GridViewColumn Header="Power (W)" DisplayMemberBinding="{Binding PowerWatts}" Width="80"/>
                    <GridViewColumn Header="Total (W)" DisplayMemberBinding="{Binding TotalPower}" Width="80"/>
                    <GridViewColumn Header="Daily Wh" DisplayMemberBinding="{Binding DailyWh}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10">
            <TextBlock Text="Summary:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Result.TotalInstantaneousLoad, StringFormat='Total Load: {0:F0} W'}"/>
            <TextBlock Text="{Binding Result.DailyConsumptionKwh, StringFormat='Daily: {0:F2} kWh'}"/>
            <TextBlock Text="{Binding Result.MonthlyConsumptionKwh, StringFormat='Monthly: {0:F2} kWh'}"/>
        </StackPanel>
    </DockPanel>
</UserControl>