<UserControl x:Class="Toolkit.UI.Views.RfCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Application.ViewModels;assembly=Toolkit.Application">
    <UserControl.DataContext>
        <vm:RfCalculatorViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <StackPanel>
            <GroupBox Header="Frequency ↔ Wavelength">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Frequency (MHz):" Width="120"/>
                        <TextBox Text="{Binding FrequencyMHz, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Wavelength (m):" Width="120"/>
                        <TextBox Text="{Binding WavelengthM, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="dBm ↔ Watt" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="dBm:" Width="120"/>
                        <TextBox Text="{Binding DbmValue, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Watt:" Width="120"/>
                        <TextBox Text="{Binding WattValue, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <TextBlock Text="{Binding CalculationEquation}" TextWrapping="Wrap" Margin="5,15,5,0" FontFamily="Consolas"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="5"/>
            <Button Content="Clear / Reset" Command="{Binding ClearCommand}" Width="100" HorizontalAlignment="Right" Margin="0,10"/>
        </StackPanel>
    </Grid>
</UserControl>