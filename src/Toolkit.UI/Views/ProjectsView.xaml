<UserControl x:Class="Toolkit.UI.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Application.ViewModels;assembly=Toolkit.Application">
    <UserControl.DataContext>
        <vm:ProjectsViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="80"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Width="80" Margin="5,0"/>
                <Button Content="Export CSV" Click="ExportCsv_Click" Width="80" Margin="5,0"/>
            </StackPanel>
            <ListView ItemsSource="{Binding SavedCalculations}" SelectedItem="{Binding SelectedCalculation}" Margin="0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Project" DisplayMemberBinding="{Binding ProjectName}" Width="120"/>
                        <GridViewColumn Header="Tool" DisplayMemberBinding="{Binding ToolName}" Width="100"/>
                        <GridViewColumn Header="Date" DisplayMemberBinding="{Binding CreatedAt}" Width="100"/>
                        <GridViewColumn Header="Notes" DisplayMemberBinding="{Binding Notes}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>