<UserControl x:Class="Toolkit.UI.Views.MicrowaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Application.ViewModels;assembly=Toolkit.Application">
    <UserControl.DataContext>
        <vm:MicrowaveViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Site A" FontWeight="Bold"/>
            <WrapPanel><TextBlock Text="Latitude:" Width="100"/><TextBox Text="{Binding LatA}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Longitude:" Width="100"/><TextBox Text="{Binding LonA}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Height (m):" Width="100"/><TextBox Text="{Binding HeightA}" Width="80"/></WrapPanel>

            <TextBlock Text="Site B" FontWeight="Bold" Margin="0,10,0,0"/>
            <WrapPanel Margin="0,2"><TextBlock Text="Latitude:" Width="100"/><TextBox Text="{Binding LatB}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Longitude:" Width="100"/><TextBox Text="{Binding LonB}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Height (m):" Width="100"/><TextBox Text="{Binding HeightB}" Width="80"/></WrapPanel>

            <TextBlock Text="RF Parameters" FontWeight="Bold" Margin="0,10,0,0"/>
            <WrapPanel Margin="0,2"><TextBlock Text="Frequency (MHz):" Width="100"/><TextBox Text="{Binding FrequencyMHz}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="TX Power (dBm):" Width="100"/><TextBox Text="{Binding TxPowerDbm}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Antenna Gain (dBi):" Width="100"/><TextBox Text="{Binding AntennaGainDbi}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Cable Loss (dB):" Width="100"/><TextBox Text="{Binding CableLossDb}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="Connector Loss (dB):" Width="100"/><TextBox Text="{Binding ConnectorLossDb}" Width="80"/></WrapPanel>
            <WrapPanel Margin="0,2"><TextBlock Text="RX Sensitivity (dBm):" Width="100"/><TextBox Text="{Binding RxSensitivityDbm}" Width="80"/></WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button Content="Calculate" Command="{Binding CalculateCommand}" Width="80" Margin="2"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Width="80" Margin="2"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <StackPanel>
                <TextBlock Text="Results" FontWeight="Bold"/>
                <TextBlock Text="{Binding Result.DistanceKm, StringFormat='Distance: {0:F3} km'}"/>
                <TextBlock Text="{Binding Result.LineOfSightApprox, StringFormat='Approx LOS: {0:F1} km'}"/>
                <TextBlock Text="{Binding Result.FresnelZoneRadiusM, StringFormat='Fresnel Radius: {0:F1} m'}"/>
                <TextBlock Text="{Binding Result.FsplDb, StringFormat='FSPL: {0:F2} dB'}"/>
                <TextBlock Text="{Binding Result.ReceivedPowerDbm, StringFormat='RX Power: {0:F2} dBm'}"/>
                <TextBlock Text="{Binding Result.LinkMarginDb, StringFormat='Link Margin: {0:F2} dB'}"/>
                <TextBlock Text="{Binding Result.LinkStatus, StringFormat='Status: {0}'}" FontWeight="Bold"/>
            </StackPanel>
            <Canvas Height="150" Background="LightGray" Margin="0,10">
                <Line X1="20" Y1="75" X2="280" Y2="75" Stroke="Blue" StrokeThickness="2"/>
                <Ellipse Canvas.Left="20" Canvas.Top="70" Width="10" Height="10" Fill="Red"/>
                <Ellipse Canvas.Left="280" Canvas.Top="70" Width="10" Height="10" Fill="Green"/>
                <TextBlock Canvas.Left="10" Canvas.Top="55" Text="A"/>
                <TextBlock Canvas.Left="285" Canvas.Top="55" Text="B"/>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>