<UserControl x:Class="Toolkit.UI.Views.IpSubnetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Application.ViewModels;assembly=Toolkit.Application">
    <UserControl.DataContext>
        <vm:IpSubnetViewModel/>
    </UserControl.DataContext>
    <StackPanel Margin="10">
        <WrapPanel><TextBlock Text="IP Address:" Width="100"/><TextBox Text="{Binding IpAddress}" Width="120"/></WrapPanel>
        <WrapPanel Margin="0,5"><TextBlock Text="CIDR:" Width="100"/><TextBox Text="{Binding Cidr}" Width="120"/></WrapPanel>
        <Button Content="Calculate" Command="{Binding CalculateCommand}" Width="80" Margin="0,10"/>
        <Button Content="Clear" Command="{Binding ClearCommand}" Width="80" Margin="5,0"/>
        <TextBlock Text="{Binding Error}" Foreground="Red"/>
        <TextBlock Text="Subnet Info:" FontWeight="Bold" Margin="0,10,0,5"/>
        <TextBlock Text="{Binding Result.NetworkAddress, StringFormat='Network: {0}'}"/>
        <TextBlock Text="{Binding Result.BroadcastAddress, StringFormat='Broadcast: {0}'}"/>
        <TextBlock Text="{Binding Result.FirstHost, StringFormat='First Host: {0}'}"/>
        <TextBlock Text="{Binding Result.LastHost, StringFormat='Last Host: {0}'}"/>
        <TextBlock Text="{Binding Result.NumberOfHosts, StringFormat='Hosts: {0}'}"/>
        <TextBlock Text="{Binding Result.SubnetMask, StringFormat='Mask: {0}'}"/>
        <TextBlock Text="{Binding Result.WildcardMask, StringFormat='Wildcard: {0}'}"/>
    </StackPanel>
</UserControl>