<UserControl x:Class="Toolkit.UI.Views.EquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Application.ViewModels;assembly=Toolkit.Application">
    <UserControl.DataContext>
        <vm:EquipmentViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Form -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Equipment Details" FontWeight="Bold" Margin="0,0,0,10"/>
            <WrapPanel><TextBlock Text="Category:" Width="100"/><TextBox Text="{Binding Category}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Manufacturer:" Width="100"/><TextBox Text="{Binding Manufacturer}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Model:" Width="100"/><TextBox Text="{Binding Model}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Type:" Width="100"/><TextBox Text="{Binding Type}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Freq (MHz):" Width="100"/><TextBox Text="{Binding FrequencyMHz}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Power (W):" Width="100"/><TextBox Text="{Binding PowerWatts}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Voltage:" Width="100"/><TextBox Text="{Binding Voltage}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Gain:" Width="100"/><TextBox Text="{Binding Gain}" Width="150"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Specifications:" Width="100"/><TextBox Text="{Binding Specifications}" Width="150" Height="40" TextWrapping="Wrap" AcceptsReturn="True"/></WrapPanel>
            <WrapPanel Margin="0,5"><TextBlock Text="Notes:" Width="100"/><TextBox Text="{Binding Notes}" Width="150" Height="40" TextWrapping="Wrap" AcceptsReturn="True"/></WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button Content="Add" Command="{Binding AddCommand}" Width="60" Margin="2"/>
                <Button Content="Update" Command="{Binding UpdateCommand}" Width="60" Margin="2"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Width="60" Margin="2"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Width="60" Margin="2"/>
            </StackPanel>
        </StackPanel>

        <!-- List -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <ListView ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipment}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="80"/>
                        <GridViewColumn Header="Manufacturer" DisplayMemberBinding="{Binding Manufacturer}" Width="100"/>
                        <GridViewColumn Header="Model" DisplayMemberBinding="{Binding Model}" Width="100"/>
                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="80"/>
                        <GridViewColumn Header="Freq (MHz)" DisplayMemberBinding="{Binding FrequencyMHz}" Width="80"/>
                        <GridViewColumn Header="Power (W)" DisplayMemberBinding="{Binding PowerWatts}" Width="80"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>