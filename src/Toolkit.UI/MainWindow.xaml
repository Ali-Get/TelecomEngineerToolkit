<Window x:Class="Toolkit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Toolkit.UI.Views"
        Title="Telecom Engineer Toolkit" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="MainTabControl">
        <TabItem Header="Dashboard" Tag="Dashboard">
            <views:DashboardView/>
        </TabItem>
        <TabItem Header="RF Calculator" Tag="RF">
            <views:RfCalculatorView/>
        </TabItem>
        <TabItem Header="Link Budget" Tag="Link">
            <views:LinkBudgetView/>
        </TabItem>
        <TabItem Header="Fiber Budget" Tag="Fiber">
            <views:FiberBudgetView/>
        </TabItem>
        <TabItem Header="Battery Backup" Tag="Battery">
            <views:BatteryBackupView/>
        </TabItem>
        <TabItem Header="Site Power" Tag="SitePower">
            <views:SitePowerView/>
        </TabItem>
        <TabItem Header="IP Subnet" Tag="IP">
            <views:IpSubnetView/>
        </TabItem>
        <TabItem Header="Unit Converter" Tag="Unit">
            <views:UnitConverterView/>
        </TabItem>
        <TabItem Header="Microwave" Tag="Micro">
            <views:MicrowaveView/>
        </TabItem>
        <TabItem Header="Sites" Tag="Sites">
            <views:SitesView/>
        </TabItem>
        <TabItem Header="Equipment" Tag="Equip">
            <views:EquipmentView/>
        </TabItem>
        <TabItem Header="Projects" Tag="Projects">
            <views:ProjectsView/>
        </TabItem>
        <TabItem Header="Coverage" Tag="Coverage">
            <views:CoverageView/>
        </TabItem>
    </TabControl>
</Window>